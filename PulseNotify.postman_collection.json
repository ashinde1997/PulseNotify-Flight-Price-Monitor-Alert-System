              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returns JWT access token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.access).to.be.a(\"string\");",
              "    pm.collectionVariables.set(\"userToken\", jsonData.access);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{currentUsername}}\",\n  \"password\": \"securepass123\"\n}"
