{
  "info": {
    "_postman_id": "c1f7a2d4-8392-411a-965a-0d8b5c92c81a",
    "name": "PulseNotify - Flight Price Monitor & Alert System",
    "description": "Postman Collection covering all 13 required scenarios using Indian domestic routes and user data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "currentUsername",
      "value": "aarav_patel",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "alertId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Register a new user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate unique Indian username so collection is repeatable",
              "const randomId = Math.floor(1000 + Math.random() * 9000);",
              "const username = 'aarav_' + randomId;",
              "pm.collectionVariables.set('currentUsername', username);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Returns username, access token, and role user\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.username).to.eql(pm.collectionVariables.get(\"currentUsername\"));",
              "    pm.expect(jsonData.role).to.eql(\"user\");",
              "    pm.expect(jsonData.access).to.be.a(\"string\");",
              "    pm.collectionVariables.set(\"userToken\", jsonData.access);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{currentUsername}}\",\n  \"password\": \"securepass123\",\n  \"email\": \"{{currentUsername}}@pulsenotify.in\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register", ""]
        }
      }
    },
    {
      "name": "2. Register with duplicate username",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{currentUsername}}\",\n  \"password\": \"anotherpassword\",\n  \"email\": \"duplicate@pulsenotify.in\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register", ""]
        }
      }
    },
    {
      "name": "3. Login with valid credentials",
      "event": [
